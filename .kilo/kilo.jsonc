{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/config": "deny"
    },
    "edit": {
      "*": "allow",
      ".kilo/**": "deny",
      ".git/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny",
      "Remove-Item*-Recurse*": "deny"
    }
  }
}