{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/config": "deny"
    },
    "edit": {
      "*": "allow",
      ".kilo/**": "deny",
      ".git/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push --force*": "deny",
      "git reset --hard*": "deny"
    }
  }
}